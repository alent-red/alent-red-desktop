{
  "name": "alent-red-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Alent.Red Desktop",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/core-install.mjs --skip-if-present",
    "web:dev": "vite",
    "web:build": "npm run web:check && vite build",
    "web:typecheck": "tsc",
    "web:lint": "eslint . --max-warnings=0",
    "web:lint:fix": "eslint . --fix",
    "web:format": "prettier --write .",
    "web:format:check": "prettier --check .",
    "web:check": "npm run web:typecheck && npm run web:lint && npm run web:format:check",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets",
    "rust:typecheck": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:check": "npm run rust:fmt:check && npm run rust:clippy && npm run rust:typecheck",
    "app:dev": "tauri dev",
    "app:build": "npm run rust:check && npm run web:build && tauri build",
    "check": "npm run web:check && npm run rust:check",
    "core:install": "node scripts/core-install.mjs",
    "core:update": "node scripts/core-update.mjs",
    "release": "dotenv -- node scripts/release.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.100.10",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-textarea-autosize": "^8.5.9",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.59.3",
    "unified": "^11.0.5",
    "vite": "^7.0.4"
  }
}
