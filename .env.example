# Copy this file to .env (gitignored) and fill in real values.
# Only `npm run release` reads .env. Local builds (npm run app:build) ignore it
# and produce ad-hoc-signed artifacts.

# ============================================================================
# Apple signing + notarization (macOS release)
# ============================================================================

# Developer ID Application certificate identity, as shown by:
#   security find-identity -v -p codesigning
# Format: "Developer ID Application: Your Name (TEAMID)"
APPLE_SIGNING_IDENTITY=

# Apple ID used for notarization (must own the Developer ID cert above, or be
# a team member with the right role).
APPLE_ID=

# App-specific password for the Apple ID above.
# Generate at: https://appleid.apple.com -> Sign-in & Security -> App-Specific Passwords
# Do NOT use your Apple account password directly — notarytool rejects it.
APPLE_PASSWORD=

# 10-character alphanumeric Team ID. Same string that appears in parentheses
# at the end of APPLE_SIGNING_IDENTITY.
APPLE_TEAM_ID=

# ============================================================================
# Tauri updater signing keypair (all platforms)
# ============================================================================

# Generate once with:
#   npm run tauri signer generate -- -w ~/.tauri/alent-red-updater.key
# Paste the contents of the generated private key file here (multi-line: wrap
# in quotes and preserve newlines as \n, or use a single-line base64 form per
# Tauri docs).
# The matching public key is committed to tauri.conf.json#plugins.updater.pubkey.
# Lose this key and existing users can never auto-update again — store it in a
# password manager + a secure CI secret.
TAURI_SIGNING_PRIVATE_KEY=

# Passphrase used when generating the keypair above (empty string if you chose
# no passphrase, but a passphrase is recommended).
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
